{
  "name": "notix-dsh-ui",
  "version": "0.1.2",
  "description": "Settings UI for the Notix notification plugin: triggers, quiet hours, content and macOS channel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.png",
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notification",
    "settings-ui",
    "deepseek-harness"
  ],
  "icon": "./icon.png"
}
